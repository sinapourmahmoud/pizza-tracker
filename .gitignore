```gitignore
# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
/bin/
/build/

# Go coverage
coverage.out
coverage.html

# Go workspace
go.work
go.work.sum

# Dependencies / vendor
vendor/

# Environment variables / secrets
.env
.env.*
!.env.example

# SQLite database files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
tmp/
temp/
```
